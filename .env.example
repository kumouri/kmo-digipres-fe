# Base URL for the kmo-digipres-be Spring Boot API.
# Default matches `./gradlew bootRun` on a sibling clone of kmo-digipres-be.
VITE_API_BASE_URL=http://localhost:8080/api

# When "true", Vite bootstraps the MSW worker so the app can run without a real
# backend. Used by Playwright smoke tests; set to "false" for manual dev against
# a running Spring Boot.
VITE_USE_MOCKS=false
