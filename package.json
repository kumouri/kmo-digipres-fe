{
  "name": "kmo-digipres-fe",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kmosf/crm-admin",
    "build": "npm run build -w @kmosf/crm-admin",
    "preview": "npm run preview -w @kmosf/crm-admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run build",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:install": "playwright install --with-deps chromium",
    "test:smoke:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^5.6.2"
  }
}
